# ============================================================
# Biến môi trường của agent. KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env  rồi sửa giá trị (.env nằm trong .gitignore)
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Security — bắt buộc khi ENVIRONMENT=production. Tạo key: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=change-me

# Redis (docker compose tự đặt redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request / 60 giây / API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard (USD, tính theo UTC)
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
